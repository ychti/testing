# Operator session auth
ENTERPRISE_ADMIN_EMAIL=admin@aussurveillance.local
ENTERPRISE_ADMIN_PASSWORD=changeme-admin
ENTERPRISE_SESSION_SECRET=replace-with-long-random-secret

# API key config (JSON array)
# Example:
# ENTERPRISE_API_KEYS_JSON=[{"key":"replace-me","tenant":"internal","actorId":"pilot-client","scopes":["portfolio:read","sites:read","site:read","legacy:import","firestore:read","audit:read","tenant:read","tenant:write"]}]
ENTERPRISE_API_KEYS_JSON=

# Optional fallback for local testing only
# ENTERPRISE_DEFAULT_API_KEY=replace-me
# ENTERPRISE_DEFAULT_API_TENANT=internal

# Firebase Admin credentials for server-side Firestore import
# Provide one of the following:
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=aus-surveillance

# Optional live public pull override
PUBLIC_AUS_SURVEILLANCE_API_KEY=
PUBLIC_AUS_SURVEILLANCE_PROJECT_ID=aus-surveillance
PUBLIC_AUS_SURVEILLANCE_EMAIL=
PUBLIC_AUS_SURVEILLANCE_PASSWORD=
AUS_SURVEILLANCE_IMPORTER_BASE_URL=https://raw.githubusercontent.com/ychti/aus-surveillance/main

# Exposure model calibration (optional)
EXPOSURE_BASE_LOSS_RATE=0.0048
EXPOSURE_RISK_SLOPE=0.0265
EXPOSURE_CONFIDENCE_PENALTY=0.42
EXPOSURE_FRESHNESS_PENALTY=0.28

# Tenant persistence store (JSON file, replace with managed DB in production)
ENTERPRISE_TENANT_STORE_PATH=/tmp/aussurveillance-enterprise-tenants.json

# Public convenience toggles (set false in production)
ALLOW_PUBLIC_LIVE_IMPORT=false
ALLOW_PUBLIC_TENANT_READ=false
ALLOW_PUBLIC_TENANT_WRITE=false

# Standalone Google surveillance CLI tools (not website UI)
# Optional shared key for both Maps + Vision:
GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_VISION_API_KEY=
GOOGLE_STREETVIEW_RADIUS_METERS=120

# Audit log output path
ENTERPRISE_AUDIT_LOG_PATH=/tmp/aussurveillance-enterprise-audit.log
